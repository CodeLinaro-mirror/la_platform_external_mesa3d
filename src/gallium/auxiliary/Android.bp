        ":blend_h",
        ":p_defines_h",
        ":p_video_enums_h",
    ],
    tools: [
        "enums2names_py_binary",
    ],
    cmd: "$(location enums2names_py_binary) $(location :p_defines_h) $(location " +
        ":p_video_enums_h) $(location :blend_h) -C $(location tr_util.c) -H " +
        "$(genDir)/tr_util.h",
}

genrule {
