{
  // This file configures the build for a Meson-based project. It is used by the
  // generic MesonProjectBuilder to generate toolchains, dependencies, and other
  // necessary build files.
  //
  // The structure is composed of two main sections:
  // 1. "common": Holds configurations that are shared across all target platforms.
  // 2. "platforms": Contains platform-specific configurations that can override
  //    or extend the common settings.
  //
  // The builder merges these sections based on the target platform. For example,
  // when building for "linux-x64", the builder will merge the settings from
  // "common" and "platforms.linux-x64".
  "project_name": "mesa3d",
  "source_path": "third_party/mesa3d",
  "common": {
    // "dependencies": A dictionary of libraries required for the build. These
    // are used to generate pkg-config (.pc) files, which Meson uses to find
    // libraries and their headers.
    "dependencies": {},
    // "meson_options": A dictionary of Meson feature flags and settings.
    // These are passed to the `meson setup` command.
    "meson_options": {
      "-Dbuildtype": "release",
      "-Db_ndebug": "true",
      "-Dvulkan-drivers": "swrast",
      "-Dgallium-drivers": "llvmpipe",
      "-Dopengl": "true",
      "-Degl": "enabled",
      "-Dgles1": "enabled",
      "-Dgles2": "enabled",
      "-Dvideo-codecs": "[]",
      "-Dzstd": "disabled",
      "-Dshared-llvm": "enabled",
      "-Dplatforms": "x11,wayland",
      "-Dgbm": "disabled",
      "-Dcpp_rtti": "false"
    },
    // "generated_files": A list of files to be generated by the build script.
    "generated_files": []
  },
  "platforms": {
    "linux-x64": {
      "meson_options": {
        "-Dcpp_args": "-DUSE_UNW_DYNAMIC_FDE -fstack-clash-protection",
        "-Dc_args": "-DUSE_UNW_DYNAMIC_FDE -fstack-clash-protection",
        "-Dcpp_link_args": "-Wl,-rpath,'$ORIGIN/:$ORIGIN/lib64:$ORIGIN/../lib64:$ORIGIN/../../lib64:$ORIGIN/../../../lib64'",
        "-Dc_link_args": "-Wl,-rpath,'$ORIGIN/:$ORIGIN/lib64:$ORIGIN/../lib64:$ORIGIN/../../lib64:$ORIGIN/../../../lib64'",
        "-Dglx-direct": "false"
      },
      // binaries are a set of bazel targets for which we will create programs
      "binaries": {
        "python3": "@lavapipe_bazel_deps//:python3",
        "wayland-scanner": "@wayland//:wayland-scanner",
        // TODO(joshuaduong): These lavapipe deps should be built from source.
        "glslangValidator": "@glslang//:glslangValidator",
        "llvm-config": "@lavapipe_bazel_deps//:py_llvm_config",
        "flex": "@flex//:flex",
        "bison": "@bison//:bison"
      },
      "dependencies": {
        "zlib": {
          "lib_type": "bazel",
          "bazel_target": "@zlib//:zlib",
          "version": "1.3.1.bcr.5",
          "shim": {
            "name": "zlib",
            "Libs": "-lz"
          }
        },
        "expat": {
          "lib_type": "bazel",
          "bazel_target": "@libexpat//:expat",
          "version": "2.7.1.aemu",
          "shim": {
            "name": "expat",
            "Libs": "-lexpat"
          }
        },
        "libdrm": {
          "lib_type": "bazel",
          "bazel_target": "@libdrm//:drm",
          "version": "2.4.110",
          "shim": {
            "name": "libdrm",
            "Libs": "${libdir}/libdrm.a",
            // Hack: loader_dri_helper.h unconditionally includes <xcb/dri3.h>
            // when HAVE_X11_PLATFORM is defined, but gbm_dri target in Meson
            // doesn't explicitly depend on xcb-dri3.
            // We force it transitively here via libdrm which gbm_dri depends on.
            "Requires": "xcb-dri3"
          }
        },
        "libffi": {
          "lib_type": "bazel",
          "bazel_target": "@libffi//:ffi",
          "version": "3.4.7.bcr.3.aemu",
          "shim": {
            "name": "ffi",
            "Libs": "-lffi"
          }
        },
        "x11": {
          "lib_type": "bazel",
          "bazel_target": "@libx11//:libx11",
          "version": "1.8.12.bcr.3.aemu",
          "shim": {
            "name": "x11",
            "Libs": "-lx11"
          }
        },
        // libx11-xcb is built into the libx11 library
        "libx11-xcb": {
          "lib_type": "bazel",
          "bazel_target": "@libx11//:libx11",
          "version": "1.8.12.bcr.3.aemu",
          "shim": {
            "name": "x11-xcb",
            "Libs": "-lx11"
          }
        },
        "libxcb": {
          "lib_type": "bazel",
          "bazel_target": "@libxcb//:libxcb",
          "version": "1.17.0.bcr.2.aemu",
          "shim": {
            "name": "xcb",
            "Libs": "-lxcb-aemu",
            "include_target": "@libxcb//:xcb_lib"
          }
        },
        // All of the xcb extensions are built into the libxcb library.
        "libxcb-dri3": {
          "lib_type": "bazel",
          "bazel_target": "@libxcb//:libxcb",
          "version": "1.17.0.bcr.2.aemu",
          "shim": {
            "name": "xcb-dri3",
            "Libs": "-lxcb-aemu",
            "include_target": "@libxcb//:xcb_lib",
            // Hack: loader_dri3_helper.c unconditionally includes <X11/Xlib-xcb.h>
            // but libdri target in Meson doesn't explicitly depend on x11-xcb.
            // We force it transitively here via xcb-dri3 which libdri depends on.
            "Requires": "x11-xcb"
          }
        },
        "libxcb-present": {
          "lib_type": "bazel",
          "bazel_target": "@libxcb//:libxcb",
          "version": "1.17.0.bcr.2.aemu",
          "shim": {
            "name": "xcb-present",
            "Libs": "-lxcb-aemu",
            "include_target": "@libxcb//:xcb_lib"
          }
        },
        "libxcb-randr": {
          "lib_type": "bazel",
          "bazel_target": "@libxcb//:libxcb",
          "version": "1.17.0.bcr.2.aemu",
          "shim": {
            "name": "xcb-randr",
            "Libs": "-lxcb-aemu",
            "include_target": "@libxcb//:xcb_lib"
          }
        },
        "libxcb-shm": {
          "lib_type": "bazel",
          "bazel_target": "@libxcb//:libxcb",
          "version": "1.17.0.bcr.2.aemu",
          "shim": {
            "name": "xcb-shm",
            "Libs": "-lxcb-aemu",
            "include_target": "@libxcb//:xcb_lib"
          }
        },
        "libxcb-sync": {
          "lib_type": "bazel",
          "bazel_target": "@libxcb//:libxcb",
          "version": "1.17.0.bcr.2.aemu",
          "shim": {
            "name": "xcb-sync",
            "Libs": "-lxcb-aemu",
            "include_target": "@libxcb//:xcb_lib"
          }
        },
        "libxcb-xfixes": {
          "lib_type": "bazel",
          "bazel_target": "@libxcb//:libxcb",
          "version": "1.17.0.bcr.2.aemu",
          "shim": {
            "name": "xcb-xfixes",
            "Libs": "-lxcb-aemu",
            "include_target": "@libxcb//:xcb_lib"
          }
        },
        "xcb-glx": {
          "lib_type": "bazel",
          "bazel_target": "@libxcb//:libxcb",
          "version": "1.17.0.bcr.2.aemu",
          "shim": {
            "name": "xcb-glx",
            "Libs": "-lxcb-aemu",
            "include_target": "@libxcb//:xcb_lib"
          }
        },
        "wayland-client": {
          "lib_type": "bazel",
          "bazel_target": "@wayland//:wayland-client",
          "version": "1.22.0",
          "shim": {
            "name": "wayland-client",
            "Libs": "${libdir}/libwayland-client.a",
            "Requires": "ffi"
          }
        },
        "wayland-server": {
          "lib_type": "bazel",
          "bazel_target": "@wayland//:wayland-server",
          "version": "1.22.0",
          "shim": {
            "name": "wayland-server",
            "Libs": "-lwayland-server"
          }
        },
        "wayland-scanner": {
          "lib_type": "bazel",
          "bazel_target": "@wayland//:wayland-scanner",
          "version": "1.22.0",
          "shim": {
            "name": "wayland-scanner",
            "extra_vars": {
              // This value is how mesa finds the wayland-scanner binary.
              "wayland_scanner": "${libdir}/wayland-scanner"
            }
          }
        },
        "wayland-egl-backend": {
          "lib_type": "bazel",
          "bazel_target": "@wayland//:wayland-server",
          "version": "3",
          "shim": {
            "name": "wayland-egl-backend",
            "Libs": "",
            "Requires": "wayland-server"
          }
        },
        "xext": {
          "lib_type": "bazel",
          "bazel_target": "@libxext//:libxext",
          "version": "1.3.6",
          "shim": {
            "name": "xext",
            "Libs": "-lxext"
          }
        },
        "glproto": {
          "lib_type": "bazel",
          "bazel_target": "@xorgproto//:xorgproto",
          "version": "2024.1.bcr.1",
          "shim": {
            "name": "glproto",
            "Libs": ""
          }
        },
        "libxrandr": {
          "lib_type": "bazel",
          "bazel_target": "@libxrandr//:libxrandr",
          "version": "1.5.4",
          "shim": {
            "name": "xrandr",
            "Libs": "-lxrandr"
          }
        },
        "xshmfence": {
          "lib_type": "bazel",
          "bazel_target": "@libxshmfence//:xshmfence",
          "version": "1.3.3",
          "shim": {
            "name": "xshmfence",
            "Libs": "-lxshmfence"
          }
        }
      }
    },
    "mac-aarch64": {
      "meson_options": {
        "-Dcpp_args": "-mmacosx-version-min=11.0",
        "-Dcpp_link_args": "-Wl,-rpath,@executable_path/../lib",
        "-Dplatforms": "[]",
        "-Dmoltenvk-dir": "/tmp/moltenvk" // Placeholder, might not be needed if we don't build moltenvk here
      },
      "binaries": {
        "python3": "@lavapipe_bazel_deps//:python3",
        "llvm-config": "//third_party/mesa3d/aemu-bazel/mac_utils:py_llvm_config",
        "glslangValidator": "//third_party/mesa3d/aemu-bazel/mac_utils:py_glslangValidator"
      },
      "dependencies": {
        "zlib": {
          "lib_type": "bazel",
          "bazel_target": "@zlib//:zlib",
          "version": "1.3.1.bcr.5",
          "shim": {
            "name": "zlib",
            "Libs": "-lz"
          }
        },
        "expat": {
          "lib_type": "bazel",
          "bazel_target": "@libexpat//:expat",
          "version": "2.7.1.aemu",
          "shim": {
            "name": "expat",
            "Libs": "-lexpat"
          }
        },
        "libpng": {
          "lib_type": "bazel",
          "bazel_target": "@libpng//:png",
          "version": "1.6.40",
          "shim": {
            "name": "libpng",
            "Libs": "-lpng16"
          }
        },
        "libffi": {
          "lib_type": "bazel",
          "bazel_target": "@libffi//:ffi",
          "version": "3.4.7.bcr.3.aemu",
          "shim": {
            "name": "ffi",
            "Libs": "-lffi"
          }
        }
      }
    },
    "mac-x64": {
      "meson_options": {
        "-Dcpp_args": "-mmacosx-version-min=11.0",
        "-Dcpp_link_args": "-Wl,-rpath,@executable_path/../lib",
        "-Dplatforms": "[]",
        "-Dmoltenvk-dir": "/tmp/moltenvk"
      },
      "binaries": {
        "python3": "@lavapipe_bazel_deps//:python3",
        "llvm-config": "//third_party/mesa3d/aemu-bazel/mac_utils:py_llvm_config",
        "glslangValidator": "//third_party/mesa3d/aemu-bazel/mac_utils:py_glslangValidator"
      },
      "dependencies": {
        "zlib": {
          "lib_type": "bazel",
          "bazel_target": "@zlib//:zlib",
          "version": "1.3.1.bcr.5",
          "shim": {
            "name": "zlib",
            "Libs": "-lz"
          }
        },
        "expat": {
          "lib_type": "bazel",
          "bazel_target": "@libexpat//:expat",
          "version": "2.7.1.aemu",
          "shim": {
            "name": "expat",
            "Libs": "-lexpat"
          }
        },
        "libpng": {
          "lib_type": "bazel",
          "bazel_target": "@libpng//:png",
          "version": "1.6.40",
          "shim": {
            "name": "libpng",
            "Libs": "-lpng16"
          }
        },
        "libffi": {
          "lib_type": "bazel",
          "bazel_target": "@libffi//:ffi",
          "version": "3.4.7.bcr.3.aemu",
          "shim": {
            "name": "ffi",
            "Libs": "-lffi"
          }
        }
      }
    }
  }
}