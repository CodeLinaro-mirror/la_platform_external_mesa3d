genrule {
    name: "tr_util.ch_headers",
    out: [
        "tr_util.h",
    ],
    srcs: [
        ":blend_h",
        ":p_defines_h",
        ":p_video_enums_h",
    ],
    tools: [
        "enums2names_py_binary",
    ],
    cmd: "$(location enums2names_py_binary) $(location :p_defines_h) $(location " +
        ":p_video_enums_h) $(location :blend_h) -C $(genDir)/tr_util.c -H " +
        "$(location tr_util.h)",
}

genrule {
    name: "tr_util.ch_impl",
