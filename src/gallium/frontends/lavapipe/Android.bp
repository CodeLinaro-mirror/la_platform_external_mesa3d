        "vk_entrypoints_py_binary",
    ],
    cmd: "$(location vk_entrypoints_py_binary) --xml $(location :vk_api_xml) " +
        "--proto --weak --out-h $(location lvp_entrypoints.h) --out-c " +
        "$(genDir)/lvp_entrypoints.c --prefix lvp --beta false",
}

