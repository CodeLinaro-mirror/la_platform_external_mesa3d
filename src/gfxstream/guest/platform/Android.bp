package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["external_mesa3d_license"],
}

cc_library_static {
    name: "platform_virtgpu",
    vendor: true,
    c_std: "c11",
    cpp_std: "c++17",
    host_supported: true,
    defaults: [
        "_trial_msvc",
        "aosp_mesa3d_c_link_args",
        "aosp_mesa3d_c_project_args",
        "aosp_mesa3d_cpp_link_args",
        "aosp_mesa3d_cpp_project_args",
        "gfxstream_guest_args",
        "vulkan_wsi_list",
    ],
    header_libs: [
        "inc_platform_virtgpu",
        "inc_src",
    ],
    srcs: [
        "VirtGpu.cpp",
    ],
    static_libs: [
        "blake3",
        "gfxstream_vulkan_mapper",
        "libvirtgpu_kumquat_ffi",
        "mesa_util",
        "mesa_util_c11",
        "mesa_util_simd",
        "platform_virtgpu_drm",
        "platform_virtgpu_kumquat",
        "vulkan_util",
    ] + select(arch(), {
        "x86_64": [
            "mesa_util_clflush",
            "mesa_util_clflushopt",
        ],
        "x86": [
            "mesa_util_clflush",
            "mesa_util_clflushopt",
        ],
        default: [],
    }),
}
